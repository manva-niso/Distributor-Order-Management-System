# Database Connection (Neon Postgres)
DATABASE_URL="postgres://user:password@ep-sample-pool.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# JWT Auth Secret (Minimum 32 characters for HS256)
JWT_SECRET="isolabs_jabalpur_distributor_secure_session_jwt_secret_key_2026"

# SMS Gateway Integration (Fast2SMS / Twilio / Webhook)
# Leave SMS_API_KEY empty in local dev to print OTPs directly to dev console/terminal
SMS_PROVIDER="fast2sms"
SMS_API_KEY=""
SMS_SENDER_ID="ISOLAB"

# Google Gemini API Key (For AI multi-modal order extraction)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"

# Pluggable Order Parser Strategy ("rules" or "custom_ml")
ORDER_PARSER_PROVIDER="rules"
CUSTOM_ML_API_URL="http://localhost:8000/api/predict"

# App Environment
NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
